{
  "name": "catalogador-alim-decupador",
  "version": "1.0.0",
  "description": "Aplicativo desktop offline para catalogação linguística (Projeto ALIM), decupagem de mídia em fila e exportação DSpace SAF.",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "build": "electron-builder"
  },
  "keywords": [
    "ALIM",
    "Lameta",
    "Dublin Core",
    "DSpace",
    "SAF",
    "FFmpeg",
    "Electron",
    "Catalogação Linguística"
  ],
  "author": "Projeto ALIM",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "br.org.alim.catalogador",
    "productName": "Catalogador ALIM",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
